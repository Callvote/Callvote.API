<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Title>Callvote.API</Title>
		<Description>Callvote system like in the Source engine for SCP:SL.</Description>
		<Version>1.0.2</Version>
	</PropertyGroup>

	<PropertyGroup>
		<DebugType>portable</DebugType>
		<Optimize>false</Optimize>
		<Configurations>Debug;Release;BareBones</Configurations>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>Callvote.API</PackageId>
		<Product>Callvote.API</Product>
		<Copyright>BSD 3-Clause License</Copyright>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<RepositoryUrl>https://github.com/Callvote/Callvote.API</RepositoryUrl>
		<PackageProjectUrl>https://callvote.me/</PackageProjectUrl>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageLicenseFile>LicenseNUGET.md</PackageLicenseFile>
		<PackageReadmeFile>ReadmeNUGET.md</PackageReadmeFile>
		<PackageIcon>Callvote.png</PackageIcon>
		<PackageTags>LabAPI,EXILED,Callvote,SCPSL,Unity</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="*.yml" />
		<None Include="..\Callvote.png" Pack="true" PackagePath="" />
		<None Include="..\License.md" Pack="true" PackagePath="" />
		<None Include="..\NugetREADME.md" Pack="true" PackagePath="" />
	</ItemGroup>

</Project>
